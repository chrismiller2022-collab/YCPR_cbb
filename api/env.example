# Public — safe to expose to the browser (read-only, RLS-protected)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by /api/cbb.ts, NEVER prefix with VITE_ (that
# prefix is what makes Vite ship a var to the browser bundle). Points at
# the SAME Supabase project as the main YCPR (CFB) repo — cbb_teams and
# cbb_rating_pulls live there too, just namespaced by table name. No
# need for a separate Supabase project unless you want fully separate
# data/billing.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — gates this app's own password screen (src/pages/PasswordGate.tsx).
# Can be the same value as the main site's ADMIN_PASSWORD or a different
# one — they're independent env vars on independent Vercel projects now.
ADMIN_PASSWORD=choose-a-password

# Server-only — used by /api/cbb.ts (api.collegebasketballdata.com)
CBBD_API_KEY=your-cbbd-api-key
